# Live (Vercel + Cloudflare tunnel) profile. scripts/setup-live.ps1 copies this to .env.live
# (git-ignored) and fills in fresh secrets. Put your own keys in .env.live, never in this file.
NODE_ENV=production
APP_NAME=Medicos

# Separate database from local dev (same Docker Postgres, database medicos_live).
DATABASE_URL=postgresql://medicos:medicos@localhost:5434/medicos_live?schema=public
REDIS_URL=redis://localhost:6380

# Fresh secrets (generated by setup-live.ps1). Never reuse the dev keys.
FIELD_ENCRYPTION_KEY=__GENERATE__
BLIND_INDEX_KEY=__GENERATE__
JWT_SECRET=__GENERATE__

# The live API listens on 4100 so it can run next to `pnpm dev` (4000).
API_PORT=4100
# The Vercel site address(es), comma-separated. Requests from any other origin are refused.
WEB_ORIGINS=https://medicos-sharrrr0001s-projects.vercel.app
REFRESH_COOKIE_PATH=/api/auth
# Browser -> Vercel -> Cloudflare tunnel -> API
TRUST_PROXY_HOPS=2
OTP_MAX_PER_IP=30
DEV_OUTBOX=false
LOG_LEVEL=info

# ---- Login codes by email (Gmail) ----
# SMTP_USER = your Gmail address. SMTP_PASS = a 16-character App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords). Not your Gmail password.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Same address as SMTP_USER, e.g. Medicos <you@gmail.com>
EMAIL_FROM=
# No SMS provider yet: phone login is hidden on the live site.
SMS_PROVIDER=console

# ---- AI: paste ONE of these keys. The server picks the provider from the key that is set. ----
# Claude Haiku (pilot grade, no training on inputs): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Gemini free key (DEMO only, fictional data; a "demo" banner is shown): https://aistudio.google.com
GEMINI_API_KEY=
# Leave both empty -> scripted questions (no real AI), demo banner shown.
LLM_PROVIDER=auto
LLM_MODEL=

# ---- Voice answers (optional). No key -> voice is switched off on the live site. ----
# Sarvam (India, production grade) or Groq Whisper (demo only).
SARVAM_API_KEY=
GROQ_API_KEY=
STT_PROVIDER=auto

# Object storage (local SeaweedFS from docker compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=medicos-live
S3_ACCESS_KEY=medicos
S3_SECRET_KEY=medicos-dev-secret
