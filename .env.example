# Copy to .env (git-ignored). Local development values only.
NODE_ENV=development
APP_NAME=Medicos

# Database (docker compose maps Postgres to host port 5434)
DATABASE_URL=postgresql://medicos:medicos@localhost:5434/medicos?schema=public
TEST_DATABASE_URL=postgresql://medicos:medicos@localhost:5434/medicos_test?schema=public
SHADOW_DATABASE_URL=postgresql://medicos:medicos@localhost:5434/medicos_shadow?schema=public
REDIS_URL=redis://localhost:6380

# Secrets: generate your own with `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
FIELD_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64
BLIND_INDEX_KEY=REPLACE_WITH_32_BYTE_BASE64
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_ORIGINS=http://localhost:3001

# Messaging adapters (dev: console SMS, Mailpit email)
SMS_PROVIDER=console
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=no-reply@medicos.local
# Dev-only OTP outbox for E2E tests. Never enabled in production.
DEV_OUTBOX=true
# OTP requests per IP per 10 min. Production default is 10; raised locally for E2E runs.
OTP_MAX_PER_IP=200

# Object storage (SeaweedFS S3 locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=medicos-dev
S3_ACCESS_KEY=medicos
S3_SECRET_KEY=medicos-dev-secret

# AI (Phase 1+)
LLM_PROVIDER=mock
LLM_MODEL=mock
# Speech-to-text: mock (dev) | groq (demo, fake data only) | sarvam (production, India)
STT_PROVIDER=mock
STT_MODEL=
STT_API_KEY=
