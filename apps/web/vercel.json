{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@medicos/web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://english-unlimited-jokes-settings.trycloudflare.com/:path*"
    }
  ]
}
