    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@medicos/config": "workspace:*",
    "@types/node": "22.18.1",
    "eslint": "9.35.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
