{
  "name": "@medicos/ai",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prompts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint src evals",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval": "tsx evals/run.ts",
    "eval:live": "tsx evals/run.ts --live"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@medicos/shared": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@medicos/config": "workspace:*",
    "@types/node": "22.18.1",
    "eslint": "9.35.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "dotenv": "17.2.2"
  }
}
