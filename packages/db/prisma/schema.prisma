// Medicos — Prisma schema v1 (spec §10).
// Fields marked "ENC" hold application-level AES-256-GCM ciphertext (see apps/api/src/crypto).
// Fields marked "BIDX" hold an HMAC-SHA256 blind index for exact-match lookup.
// There is intentionally NO triage/urgency/diagnosis column anywhere (golden rules 1-3).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Identity & auth ─────────────────────────

enum Role {
  patient
  doctor
  staff
  admin
  founder
  developer
}

enum UserStatus {
  active
  suspended
  deleted
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  phoneHash    String?    @unique // BIDX of +91XXXXXXXXXX
  phoneEnc     String? // ENC
  emailHash    String?    @unique // BIDX of lowercased email
  emailEnc     String? // ENC
  role         Role       @default(patient)
  status       UserStatus @default(active)
  totpSecretEnc String? // ENC — Phase 4
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profiles      PatientProfile[]
  consents      Consent[]
  sessions      Session[]
  doctor        Doctor?
  clinicMembers ClinicMember[]
}

enum OtpChannel {
  sms
  email
}

/// One OTP attempt window. Only an HMAC of the code is stored.
model OtpChallenge {
  id             String     @id @default(uuid()) @db.Uuid
  channel        OtpChannel
  identifierHash String // BIDX of phone/email
  identifierEnc  String // ENC — copied to the new User on first successful login
  codeHash       String
  attempts       Int        @default(0)
  expiresAt      DateTime
  consumedAt     DateTime?
  ipHash         String?
  createdAt      DateTime   @default(now())

  @@index([identifierHash, createdAt])
  @@index([ipHash, createdAt])
}

/// Refresh-token session. Token is rotated on every refresh; reuse of an old token revokes the family.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique
  deviceIdHash     String
  userAgent        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  rotatedAt        DateTime?
  revokedAt        DateTime?

  @@index([userId])
  @@index([familyId])
}

// ───────────────────────── Patients & consent ─────────────────────────

model PatientProfile {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @db.Uuid
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  medicosId   String   @unique // MED-XXXX-XXXX
  nameEnc     String // ENC
  dobEnc      String? // ENC (ISO date)
  birthYear   Int? // when only age is known
  gender      String
  city        String
  language    String   @default("hi-Latn")
  relation    String   @default("self")
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  consents        Consent[]
  appointments    Appointment[]
  intakeSessions  IntakeSession[]
  attachments     Attachment[]
  recordBook      RecordBookEntry[]
  accessGrants    AccessGrant[]

  @@index([ownerUserId])
}

enum ConsentType {
  data_processing
  share_with_doctor
  record_access
  research_optin
}

model Consent {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @db.Uuid
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientProfileId String?         @db.Uuid
  patientProfile   PatientProfile? @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  type             ConsentType
  version          String
  scope            String?
  grantedAt        DateTime        @default(now())
  revokedAt        DateTime?
  expiresAt        DateTime?

  @@index([userId, type])
  @@index([patientProfileId])
}

// ───────────────────────── Doctors & clinics ─────────────────────────

enum VerificationStatus {
  pending
  verified
  rejected
  suspended
}

model Doctor {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  specialty          String
  degrees            String[]
  registrationNo     String?
  council            String?
  yearsExperience    Int?
  languages          String[]
  photoKey           String?
  about              String?
  verificationStatus VerificationStatus @default(pending)
  verifiedAt         DateTime?
  recheckDue         DateTime?
  reportStyle        String             @default("short_en")
  createdAt          DateTime           @default(now())

  documents      VerificationDocument[]
  ownedClinics   Clinic[]
  schedules      Schedule[]
  fees           Fee[]
  appointments   Appointment[]
  intakeSessions IntakeSession[]
  accessGrants   AccessGrant[]
  templateOverride DoctorTemplateOverride?
  feedback       SummaryFeedback[]

  @@index([specialty, verificationStatus])
}

model VerificationDocument {
  id         String   @id @default(uuid()) @db.Uuid
  doctorId   String   @db.Uuid
  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  kind       String // registration_certificate | degree | government_id | photo
  s3Key      String
  status     String   @default("pending")
  reviewerId String?  @db.Uuid
  note       String?
  createdAt  DateTime @default(now())

  @@index([doctorId])
}

model Clinic {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  address       String
  city          String
  area          String?
  lat           Float?
  lng           Float?
  photos        String[]
  ownerDoctorId String?  @db.Uuid
  ownerDoctor   Doctor?  @relation(fields: [ownerDoctorId], references: [id])
  createdAt     DateTime @default(now())

  members      ClinicMember[]
  schedules    Schedule[]
  fees         Fee[]
  appointments Appointment[]
  subscriptions Subscription[]

  @@index([ownerDoctorId])
  @@index([city, area])
}

model ClinicMember {
  clinicId String @db.Uuid
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String // doctor | staff

  @@id([clinicId, userId])
  @@index([userId])
}

model Schedule {
  id          String @id @default(uuid()) @db.Uuid
  doctorId    String @db.Uuid
  doctor      Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinicId    String @db.Uuid
  clinic      Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  weekday     Int // 0 = Sunday
  start       String // "10:00"
  end         String // "14:00"
  slotMinutes Int    @default(15)

  @@index([doctorId])
  @@index([clinicId])
}

model Fee {
  id       String   @id @default(uuid()) @db.Uuid
  doctorId String   @db.Uuid
  doctor   Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinicId String   @db.Uuid
  clinic   Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  consult  Int // rupees
  followUp Int
  modes    String[]

  @@unique([doctorId, clinicId])
  @@index([clinicId])
}

// ───────────────────────── Visits & intake ─────────────────────────

enum AppointmentType {
  new
  follow_up
  walk_in
}

enum AppointmentStatus {
  booked
  confirmed
  checked_in
  completed
  cancelled
  no_show
}

enum AppointmentSource {
  patient_app
  clinic_link
  waiting_room_qr
}

model Appointment {
  id               String            @id @default(uuid()) @db.Uuid
  patientProfileId String            @db.Uuid
  patientProfile   PatientProfile    @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  doctorId         String            @db.Uuid
  doctor           Doctor            @relation(fields: [doctorId], references: [id])
  clinicId         String            @db.Uuid
  clinic           Clinic            @relation(fields: [clinicId], references: [id])
  startsAt         DateTime
  type             AppointmentType   @default(new)
  status           AppointmentStatus @default(booked)
  source           AppointmentSource @default(patient_app)
  createdAt        DateTime          @default(now())

  intakeSessions IntakeSession[]
  notes          DoctorNote[]

  @@index([doctorId, startsAt])
  @@index([patientProfileId])
  @@index([clinicId])
}

enum IntakeStatus {
  started
  paused
  submitted
  expired
}

model IntakeSession {
  id               String         @id @default(uuid()) @db.Uuid
  patientProfileId String         @db.Uuid
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  doctorId         String?        @db.Uuid
  doctor           Doctor?        @relation(fields: [doctorId], references: [id])
  appointmentId    String?        @db.Uuid
  appointment      Appointment?   @relation(fields: [appointmentId], references: [id])
  templateId       String
  templateVersion  Int
  language         String
  status           IntakeStatus   @default(started)
  answeredBy       String         @default("self")
  safetyLineShown  Boolean        @default(false)
  startedAt        DateTime       @default(now())
  submittedAt      DateTime?

  messages      IntakeMessage[]
  attachments   Attachment[]
  summaries     PreVisitSummary[]
  safetyEvents  SafetyEvent[]
  filterBlocks  FilterBlockEvent[]
  aiUsage       AiUsage[]

  @@index([patientProfileId])
  @@index([doctorId])
  @@index([appointmentId])
}

enum MessageRole {
  ai
  patient
  system
}

model IntakeMessage {
  id                   String        @id @default(uuid()) @db.Uuid
  sessionId            String        @db.Uuid
  session              IntakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role                 MessageRole
  textEnc              String // ENC
  audioKey             String?
  transcriptConfidence Float?
  filtered             Boolean       @default(false)
  createdAt            DateTime      @default(now())

  @@index([sessionId, createdAt])
}

enum AttachmentKind {
  report
  prescription
  medicine_strip
  photo_of_problem
  other
}

model Attachment {
  id                    String         @id @default(uuid()) @db.Uuid
  ownerPatientProfileId String         @db.Uuid
  owner                 PatientProfile @relation(fields: [ownerPatientProfileId], references: [id], onDelete: Cascade)
  sessionId             String?        @db.Uuid
  session               IntakeSession? @relation(fields: [sessionId], references: [id])
  kind                  AttachmentKind
  label                 String?
  s3Key                 String
  mime                  String
  sizeBytes             Int
  sha256                String
  takenAt               DateTime?
  createdAt             DateTime       @default(now())

  @@index([ownerPatientProfileId])
  @@index([sessionId])
}

enum SummaryStatus {
  draft
  delivered
  reviewed
}

model PreVisitSummary {
  id               String        @id @default(uuid()) @db.Uuid
  sessionId        String        @db.Uuid
  session          IntakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  version          Int           @default(1)
  jsonEnc          String // ENC — schema in packages/shared
  status           SummaryStatus @default(draft)
  deliveredAt      DateTime?
  openedByDoctorAt DateTime?
  createdAt        DateTime      @default(now())

  notes    DoctorNote[]
  feedback SummaryFeedback[]

  @@unique([sessionId, version])
}

// ───────────────────────── Doctor notes & records ─────────────────────────

model DoctorNote {
  id              String           @id @default(uuid()) @db.Uuid
  appointmentId   String           @db.Uuid
  appointment     Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  summaryId       String?          @db.Uuid
  summary         PreVisitSummary? @relation(fields: [summaryId], references: [id])
  assessmentEnc   String? // ENC — written by the doctor only
  planEnc         String? // ENC — written by the doctor only
  examinationEnc  String? // ENC
  testsAdvisedEnc String? // ENC
  followUpDate    DateTime?
  finalisedAt     DateTime?
  finalisedBy     String?          @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  prescriptions Prescription[]

  @@index([appointmentId])
  @@index([summaryId])
}

model Prescription {
  id        String             @id @default(uuid()) @db.Uuid
  noteId    String             @db.Uuid
  note      DoctorNote         @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  items     PrescriptionItem[]

  @@index([noteId])
}

model PrescriptionItem {
  id             String       @id @default(uuid()) @db.Uuid
  prescriptionId String       @db.Uuid
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  drug           String
  dose           String
  frequency      String
  duration       String
  instructions   String?

  @@index([prescriptionId])
}

enum RecordKind {
  doctor_note
  prescription
  pre_visit_summary
  uploaded_report
}

model RecordBookEntry {
  id               String         @id @default(uuid()) @db.Uuid
  patientProfileId String         @db.Uuid
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  kind             RecordKind
  refId            String         @db.Uuid
  date             DateTime
  title            String

  @@index([patientProfileId, date])
}

enum GrantVia {
  share
  qr_prompt
  otp
}

model AccessGrant {
  id               String         @id @default(uuid()) @db.Uuid
  patientProfileId String         @db.Uuid
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  doctorId         String         @db.Uuid
  doctor           Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  grantedVia       GrantVia
  scope            String         @default("visit")
  grantedAt        DateTime       @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([patientProfileId])
  @@index([doctorId, expiresAt])
}

// ───────────────────────── Templates & quality ─────────────────────────

model Template {
  id          String   @id @default(uuid()) @db.Uuid
  key         String // e.g. general-medicine
  specialty   String
  version     Int
  json        Json
  status      String   @default("draft") // draft | published
  publishedBy String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@unique([key, version])
}

model DoctorTemplateOverride {
  doctorId       String @id @db.Uuid
  doctor         Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  extraQuestions Json   @default("[]")
  style          String @default("short_en")
}

model SummaryFeedback {
  id           String          @id @default(uuid()) @db.Uuid
  summaryId    String          @db.Uuid
  summary      PreVisitSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  doctorId     String          @db.Uuid
  doctor       Doctor          @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  useful       Boolean
  issues       String[]
  comment      String?
  editDistance Int?
  createdAt    DateTime        @default(now())

  @@index([summaryId])
  @@index([doctorId])
}

model SafetyEvent {
  id           String        @id @default(uuid()) @db.Uuid
  sessionId    String        @db.Uuid
  session      IntakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  matchedTerms String[]
  shownAt      DateTime      @default(now())
  clinicSeenAt DateTime?

  @@index([sessionId])
}

/// No PHI text is stored here in production — only the rule id.
model FilterBlockEvent {
  id        String        @id @default(uuid()) @db.Uuid
  sessionId String        @db.Uuid
  session   IntakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stage     String // chat | summary
  rule      String
  createdAt DateTime      @default(now())

  @@index([sessionId])
}

model AiUsage {
  id           String         @id @default(uuid()) @db.Uuid
  sessionId    String?        @db.Uuid
  session      IntakeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  step         String // chat | summary | stt
  provider     String
  model        String
  inputTokens  Int            @default(0)
  outputTokens Int            @default(0)
  audioSeconds Float          @default(0)
  costInr      Decimal        @default(0) @db.Decimal(10, 4)
  latencyMs    Int            @default(0)
  createdAt    DateTime       @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

// ───────────────────────── Billing ─────────────────────────

model Plan {
  id                String   @id @default(uuid()) @db.Uuid
  key               String   @unique // free | pro | clinic | hospital
  name              String
  monthlyInr        Int?
  yearlyInr         Int?
  maxDoctors        Int?
  summariesIncluded Int?
  extraSummaryInr   Int?
  staffLogins       Int?
  features          String[]
  active            Boolean  @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id         String    @id @default(uuid()) @db.Uuid
  clinicId   String    @db.Uuid
  clinic     Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  planId     String    @db.Uuid
  plan       Plan      @relation(fields: [planId], references: [id])
  razorpayId String?   @unique
  status     String // trialing | active | past_due | cancelled
  periodEnd  DateTime?
  createdAt  DateTime  @default(now())

  usage    UsageCounter[]
  invoices Invoice[]

  @@index([clinicId])
  @@index([planId])
}

model UsageCounter {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  summaries      Int          @default(0)

  @@unique([subscriptionId, periodStart])
}

model Invoice {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  number         String       @unique
  amountInr      Int
  gstInr         Int
  pdfKey         String?
  issuedAt       DateTime     @default(now())

  @@index([subscriptionId])
}

model Coupon {
  id         String    @id @default(uuid()) @db.Uuid
  code       String    @unique
  planKey    String
  freeMonths Int
  maxUses    Int?
  used       Int       @default(0)
  expiresAt  DateTime?
}

// ───────────────────────── Messaging, ops, audit ─────────────────────────

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  channel   String // whatsapp | sms | email | push
  template  String
  status    String   @default("queued")
  createdAt DateTime @default(now())

  @@index([userId])
}

model ReminderSchedule {
  id               String   @id @default(uuid()) @db.Uuid
  patientProfileId String   @db.Uuid
  kind             String // medicine | follow_up | freshness
  refId            String?  @db.Uuid
  nextAt           DateTime
  enabled          Boolean  @default(true)

  @@index([patientProfileId])
  @@index([nextAt])
}

/// Append-only: a database trigger rejects UPDATE and DELETE (see migration).
model AuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  actorUserId      String?  @db.Uuid
  actorRole        String?
  action           String // e.g. patient_profile.read
  entity           String
  entityId         String?
  patientProfileId String?  @db.Uuid
  ipHash           String?
  userAgent        String?
  at               DateTime @default(now())

  @@index([patientProfileId, at])
  @@index([actorUserId, at])
}

model SupportTicket {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  subject   String
  status    String   @default("open")
  createdAt DateTime @default(now())

  @@index([userId])
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model DeletionRequest {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  requestedAt DateTime  @default(now())
  executeAfter DateTime
  completedAt DateTime?

  @@index([userId])
}
