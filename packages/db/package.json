{
  "name": "@medicos/db",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "lint": "eslint src prisma",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check-drift": "dotenv -e ../../.env -- sh -c \"prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code\"",
    "live:deploy": "dotenv -e ../../.env.live -- prisma migrate deploy",
    "live:seed": "dotenv -e ../../.env.live -- tsx prisma/seed.ts",
    "live:attach-email": "dotenv -e ../../.env.live -- tsx prisma/attach-email.ts",
    "make-admin": "dotenv -e ../../.env -- tsx prisma/make-admin.ts",
    "live:make-admin": "dotenv -e ../../.env.live -- tsx prisma/make-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@medicos/config": "workspace:*",
    "@medicos/shared": "workspace:*",
    "@types/node": "22.18.1",
    "dotenv-cli": "10.0.0",
    "eslint": "9.35.0",
    "prisma": "6.19.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "@medicos/ai": "workspace:*"
  }
}
